# Increase timeout for slow networks
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Disable optional dependencies if they fail
optional=true

# Use legacy peer deps to avoid conflicts
legacy-peer-deps=false

# Disable fund messages
fund=false

# Disable audit during install (faster builds)
audit=false

# Progress settings
loglevel=error
progress=false
